{
  "service": "mongodb",
  "metadata": {
    "nixpkgsRevision": "25.11pre-git"
  },
  "package": {
    "name": "mongodb",
    "version": "7.0.28"
  },
  "settings": {
    "bind_ip": {
      "default": "127.0.0.1",
      "description": "IP to bind to",
      "enum": null,
      "example": null,
      "readOnly": false,
      "required": false,
      "type": "string"
    },
    "dbpath": {
      "default": "/var/db/mongodb",
      "description": "Location where MongoDB stores its files",
      "enum": null,
      "example": null,
      "readOnly": false,
      "required": false,
      "type": "string"
    },
    "enable": {
      "default": false,
      "description": "Whether to enable the MongoDB server.",
      "enum": null,
      "example": true,
      "readOnly": false,
      "required": false,
      "type": "boolean"
    },
    "enableAuth": {
      "default": false,
      "description": "Enable client authentication. Creates a default superuser with username root!",
      "enum": null,
      "example": null,
      "readOnly": false,
      "required": false,
      "type": "boolean"
    },
    "extraConfig": {
      "default": "",
      "description": "MongoDB extra configuration in YAML format",
      "enum": null,
      "example": "storage.journal.enabled: false\n",
      "readOnly": false,
      "required": false,
      "type": "string"
    },
    "initialRootPasswordFile": {
      "default": null,
      "description": "Path to the file containing the password for the root user if auth is enabled.",
      "enum": null,
      "example": null,
      "readOnly": false,
      "required": false,
      "type": "any"
    },
    "initialScript": {
      "default": null,
      "description": "A file containing MongoDB statements to execute on first startup.\n",
      "enum": null,
      "example": null,
      "readOnly": false,
      "required": false,
      "type": "any"
    },
    "mongoshPackage": {
      "default": null,
      "description": "The mongosh package to use.",
      "enum": null,
      "example": null,
      "readOnly": false,
      "required": false,
      "type": "string"
    },
    "pidFile": {
      "default": "/run/mongodb.pid",
      "description": "Location of MongoDB pid file",
      "enum": null,
      "example": null,
      "readOnly": false,
      "required": false,
      "type": "string"
    },
    "quiet": {
      "default": false,
      "description": "quieter output",
      "enum": null,
      "example": null,
      "readOnly": false,
      "required": false,
      "type": "boolean"
    },
    "replSetName": {
      "default": "",
      "description": "If this instance is part of a replica set, set its name here.\nOtherwise, leave empty to run as single node.\n",
      "enum": null,
      "example": null,
      "readOnly": false,
      "required": false,
      "type": "string"
    },
    "user": {
      "default": "mongodb",
      "description": "User account under which MongoDB runs",
      "enum": null,
      "example": null,
      "readOnly": false,
      "required": false,
      "type": "string"
    }
  }
}
